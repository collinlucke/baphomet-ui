// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`Header > Snapshots > matches snapshot when authenticated > heading-authenticated 1`] = `
<div>
  <header
    class="ath-header css-0"
  >
    <div
      class="css-1q9shfe"
    >
      <nav
        class="css-z7mtfw"
      >
        <a
          aria-label="Baphomet - Go to homepage"
          class="css-1wvlhgx"
          data-discover="true"
          data-testid="logo-link"
          href="/"
        >
          <h1
            class="css-1ccw2wa"
          >
            Baphy
          </h1>
          <img
            alt="Baphomet logo"
            aria-hidden="true"
            class="css-xj0vep"
            role="presentation"
            src="/baphy-favicon.png"
          />
        </a>
        <div
          class="css-174f635"
        >
          <nav>
            <div
              class="ath-button-group ath-button-group-direction-row css-77ji9j"
            >
              <a
                data-discover="true"
                href="/arena"
              >
                <button
                  class="ath-button ath-button-small ath-button-ghost ath-button-dark ath-button-wrap ath-button-text-center css-0"
                  type="button"
                >
                  <div>
                    Arena 
                  </div>
                </button>
              </a>
              <a
                data-discover="true"
                href="/leaderboard"
              >
                <button
                  class="ath-button ath-button-small ath-button-ghost ath-button-dark ath-button-wrap ath-button-text-center css-0"
                  type="button"
                >
                  <div>
                    Leaderboard
                  </div>
                </button>
              </a>
              <a
                data-discover="true"
                href="/all-movies"
              >
                <button
                  class="ath-button ath-button-small ath-button-ghost ath-button-dark ath-button-wrap ath-button-text-center css-0"
                  type="button"
                >
                  <div>
                    All Movies
                  </div>
                </button>
              </a>
              <a
                data-discover="true"
                href="/faq"
              >
                <button
                  class="ath-button ath-button-small ath-button-ghost ath-button-dark ath-button-wrap ath-button-text-center css-0"
                  type="button"
                >
                  <div>
                    FAQ
                  </div>
                </button>
              </a>
            </div>
          </nav>
          <div
            class="ath-button-group ath-button-group-direction-row css-16kxbp9"
          >
            <button
              aria-describedby="signup-help"
              aria-label="Open sign up form"
              class="ath-button ath-button-small ath-button-tertiary ath-button-text-center css-0"
              data-testid="signup-button"
              type="button"
            >
              <div>
                Sign Up
              </div>
            </button>
            <button
              aria-describedby="login-help"
              aria-label="Open log in form"
              class="ath-button ath-button-small ath-button-primary ath-button-dark ath-button-text-center css-0"
              data-testid="login-button"
              type="button"
            >
              <div>
                Log in
              </div>
            </button>
            <span
              class="css-9nyaor"
              id="signup-help"
            >
              Create a new account to add and rate movies
            </span>
            <span
              class="css-9nyaor"
              id="login-help"
            >
              Sign in to your existing account
            </span>
          </div>
        </div>
      </nav>
    </div>
  </header>
</div>
`;

